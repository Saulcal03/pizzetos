---
// 1. Importación del componente (Lo único nuevo arriba)
import AddToCartBtn from '../Cart/AddToCartBtn.jsx';

interface Props {
  id: string;
  name: string;
  description: string;
  price: number;
  imageSrc: string;
  category: string; // 2. Agregamos esta propiedad obligatoria
  isPromo?: boolean;
}

const { id, name, description, price, imageSrc, category, isPromo = false } = Astro.props;
---

<article class="group relative bg-brand-surface rounded-2xl overflow-visible border border-white/5 hover:border-brand-yellow/30 transition-all duration-300 hover:shadow-xl hover:-translate-y-2 flex flex-col h-full">
  
  {/* Lógica de promo intacta */}
  {isPromo && (
    <div class="absolute -top-3 -right-3 z-20 bg-red-600 text-white text-xs font-bold px-3 py-1 rounded-full shadow-lg transform rotate-3 group-hover:rotate-6 transition-transform">
      ¡2x1!
    </div>
  )}

  {/* Imagen intacta */}
  <div class="relative h-48 w-full overflow-hidden rounded-t-2xl">
    <img 
      src={imageSrc} 
      alt={name}
      loading="lazy"
      class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-500"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-brand-surface to-transparent opacity-60"></div>
  </div>

  <div class="p-5 flex flex-col flex-grow">
    {/* Título y descripción intactos */}
    <div class="mb-4 flex-grow">
      <h3 class="font-display text-2xl text-white mb-1 tracking-wide group-hover:text-brand-yellow transition-colors">
        {name}
      </h3>
      <p class="text-brand-gray text-sm leading-relaxed">
        {description}
      </p>
    </div>

    {/* 3. CAMBIO: Aquí quitamos el <select> y <button> viejo y ponemos el componente React */}
    <div class="mt-auto">
      <AddToCartBtn 
        client:visible 
        id={id} 
        name={name} 
        basePrice={price} 
        imageSrc={imageSrc}
        category={category}
      />
    </div>
  </div>
</article>