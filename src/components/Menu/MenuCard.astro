---
// src/components/Menu/MenuCard.astro
const { 
  id, 
  name,       
  description, 
  price, 
  image, 
  category, 
  prices, 
  type = "fijo" 
} = Astro.props;

const usesModal = prices || type === 'personalizable';
---

<button 
  class={usesModal ? "open-modal-btn w-full text-left group focus:outline-none" : "add-direct-btn w-full text-left group focus:outline-none"}
  data-product={JSON.stringify({ id, name, description, image, category, price, prices, type })}
  data-id={id}
  data-name={name}
  data-price={price}
  data-image={image}
  data-category={category}
>
  <div class="relative h-[400px] w-full rounded-[2rem] overflow-hidden border border-white/5 bg-neutral-900 shadow-lg transition-all duration-500 hover:shadow-[0_0_40px_rgba(245,158,11,0.2)] hover:scale-[1.02]">
    
    <img 
      src={image} 
      alt={name} 
      class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 opacity-90 group-hover:opacity-100"
    />

    <div class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-neutral-950/40 to-transparent opacity-90 group-hover:opacity-80 transition-opacity duration-500"></div>

    <div class="absolute top-5 right-5 w-12 h-12 rounded-full bg-white/10 backdrop-blur-md border border-white/20 flex items-center justify-center text-white transition-all duration-300 group-hover:bg-amber-500 group-hover:text-black group-hover:rotate-90">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
      </svg>
    </div>

    <div class="absolute bottom-0 left-0 w-full p-8 translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
      
      <span class="text-amber-500 text-[10px] font-bold tracking-[0.2em] uppercase mb-2 block opacity-0 -translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-500 delay-100">
        {category}
      </span>

      <h3 class="text-3xl font-serif text-white italic leading-none mb-3 group-hover:text-amber-400 transition-colors">
        {name}
      </h3>

      <p class="text-neutral-400 text-sm leading-relaxed line-clamp-2 opacity-80 group-hover:opacity-100 group-hover:text-white transition-all">
        {description}
      </p>
    </div>

  </div>
</button>

<script>
  import { openProductModal, addCartItem, toggleCart } from '../../stores/cartStore.js'; 

  function initCardButtons() {
    // Lógica Modal
    const modalButtons = document.querySelectorAll('.open-modal-btn');
    modalButtons.forEach(btn => {
      if (btn.hasAttribute('data-listener-attached')) return;
      btn.addEventListener('click', (e) => {
        const button = e.currentTarget;
        try {
          // Animación de click
          button.firstElementChild.classList.add('scale-95');
          setTimeout(() => button.firstElementChild.classList.remove('scale-95'), 150);

          const productData = JSON.parse(button.dataset.product);
          openProductModal(productData);
        } catch (error) { console.error(error); }
      });
      btn.setAttribute('data-listener-attached', 'true');
    });

    // Lógica Directa (Por si acaso usas productos simples)
    const directButtons = document.querySelectorAll('.add-direct-btn');
    directButtons.forEach(btn => {
      if (btn.hasAttribute('data-listener-attached')) return;
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget;
        // Animación de click
        target.firstElementChild.classList.add('scale-95');
        setTimeout(() => target.firstElementChild.classList.remove('scale-95'), 150);

        const item = {
          id: target.dataset.id,
          name: target.dataset.name,
          price: Number(target.dataset.price),
          image: target.dataset.image,
          category: target.dataset.category,
          quantity: 1
        };
        addCartItem(item);
        toggleCart(true);
      });
      btn.setAttribute('data-listener-attached', 'true');
    });
  }

  document.addEventListener('astro:page-load', initCardButtons);
  document.addEventListener('DOMContentLoaded', initCardButtons);
</script>