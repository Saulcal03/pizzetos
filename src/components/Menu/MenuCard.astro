---
// src/components/Menu/MenuCard.astro
import AddToCartBtn from './AddToCartBtn.jsx'; 
// 1. IMPORTAMOS EL NUEVO COMPONENTE DE PRECIO
import DynamicPrice from './DynamicPrice.jsx';

const { 
  id, 
  name,       
  description, 
  price, 
  image, 
  category, 
  prices, 
  type = "fijo" 
} = Astro.props;

// --- LÓGICA DE PRECIO ---
let displayPrice = price;

if (!displayPrice && prices) {
    // Convertimos los valores a números para evitar errores y encontrar el menor
    const priceValues = Object.values(prices).map(Number);
    
    if (priceValues.length > 0) {
        displayPrice = Math.min(...priceValues);
    }
}

// Objeto para el botón de añadir al carrito
const productData = { 
    id, 
    name, 
    price: displayPrice, 
    type, 
    category,
    prices, 
    description,
    image,
    opciones: [] 
}; 
---

<div class="bg-neutral-900/50 border border-white/5 rounded-2xl overflow-hidden hover:border-amber-500/30 transition-all group h-full flex flex-col">
  <div class="relative overflow-hidden aspect-video">
      <img src={image} alt={name} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" />
      
      {/* Etiqueta de categoría */}
      <div class="absolute top-2 right-2 bg-black/60 backdrop-blur-md px-3 py-1 rounded-full border border-white/10">
        <span class="text-[10px] font-bold text-amber-500 uppercase tracking-widest">{category}</span>
      </div>
  </div>

  <div class="p-5 flex flex-col flex-grow">
    <div class="flex-grow">
        <h3 class="text-xl font-serif italic font-bold text-white mb-2">{name}</h3>
        <p class="text-gray-400 text-sm leading-relaxed mb-4 line-clamp-2">{description}</p>
    </div>

    <div class="mt-4 flex items-center justify-between gap-4">
        
        {/* 2. AQUÍ ESTÁ EL CAMBIO: Usamos el componente dinámico */}
        {/* Le pasamos 'prices' (la lista de precios) y 'basePrice' (el precio más barato calculado arriba) */}
        <DynamicPrice client:load prices={prices} basePrice={displayPrice} />
        
        <div class="w-32">
            <AddToCartBtn client:visible product={productData} />
        </div>
    </div>
  </div>
</div>