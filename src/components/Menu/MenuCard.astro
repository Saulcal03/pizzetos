---
// src/components/Menu/MenuCard.astro
import AddToCartBtn from './AddToCartBtn.jsx'; 
import DynamicPrice from './DynamicPrice.jsx';

const { 
  id, 
  name,       
  description, 
  price, 
  image, 
  category, 
  prices, 
  type = "fijo" 
} = Astro.props;

// --- LÓGICA DE PRECIO ---
let displayPrice = price;

if (!displayPrice && prices) {
    const priceValues = Object.values(prices).map(Number);
    if (priceValues.length > 0) {
        displayPrice = Math.min(...priceValues);
    }
}

const productData = { 
    id, name, price: displayPrice, type, category, prices, description, image, opciones: [] 
}; 

// Detectamos si es Pizza para aplicar el diseño especial
const isPizza = category === 'Pizzas' || category === 'Especialidades del Mar';
---

<div class="bg-neutral-900/50 border border-white/5 rounded-2xl overflow-hidden hover:border-amber-500/30 transition-all group h-full flex flex-col shadow-lg">
  
  {/* --- ZONA DE IMAGEN --- */}
  <div class="relative overflow-hidden aspect-video">
      <img src={image} alt={name} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
      
      {/* DISEÑO TIPO PAQUETE (SOLO PARA PIZZAS) */}
      {isPizza && (
        /* CAMBIO AQUI: 'hidden md:flex' oculta esto en celular y lo muestra en PC */
        <div class="hidden md:flex absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent flex-col justify-end p-3 md:p-4 z-10">
            
            {/* Título Responsivo: text-2xl en cel, text-4xl en PC */}
            <h2 class="text-2xl md:text-4xl font-black text-white italic uppercase leading-none transform -skew-x-6 drop-shadow-md mb-1">
                {name}
            </h2>
            
            {/* Botón visual "Ordena" */}
            <div class="mt-1 inline-block">
                <span class="bg-amber-500 text-neutral-900 text-[10px] md:text-xs font-black px-2 py-1 rounded-sm uppercase tracking-wider transform -skew-x-6 inline-block shadow-lg">
                    ¡ORDENAR!
                </span>
            </div>
        </div>
      )}

      {/* Etiqueta normal para lo que NO es pizza */}
      {!isPizza && (
        <div class="absolute top-2 right-2 bg-black/60 backdrop-blur-md px-3 py-1 rounded-full border border-white/10 z-20">
          <span class="text-[10px] font-bold text-amber-500 uppercase tracking-widest">{category}</span>
        </div>
      )}
  </div>

  <div class="p-4 md:p-5 flex flex-col flex-grow relative z-20 bg-neutral-900">
    <div class="flex-grow">
        {/* Si NO es pizza, mostramos el nombre abajo. Si ES pizza, ya está en la foto. */}
        {!isPizza && (
            <h3 class="text-xl font-serif italic font-bold text-white mb-2">{name}</h3>
        )}
        
        {/* Descripción: oculta en celular para pizzas para ahorrar espacio, visible en PC */}
        <p class={`text-gray-400 text-xs md:text-sm leading-relaxed mb-4 line-clamp-2 ${isPizza ? 'hidden md:block' : 'block'}`}>
            {description}
        </p>
    </div>

    {/* Footer de la tarjeta con Precio y Botón */}
    <div class={`flex items-center justify-between gap-3 border-white/5 pt-2 ${!isPizza ? 'border-t mt-2' : ''}`}>
        <DynamicPrice client:load prices={prices} basePrice={displayPrice} />
        <div class="w-28 md:w-32">
            <AddToCartBtn client:visible product={productData} />
        </div>
    </div>
  </div>
</div>