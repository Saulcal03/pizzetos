---
// src/components/Common/Footer.astro

const currentYear = new Date().getFullYear();

const socialLinks = [
  { 
    name: 'Facebook', 
    href: 'https://www.facebook.com/PizzetosPizzaMiraflores', 
    icon: 'M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z' 
  },
  { 
    name: 'WhatsApp', 
    href: 'https://wa.me/5215584457355', 
    icon: 'M3 21l1.65-3.8C2.8 15.6 2.05 13.5 2.05 11.3 2.05 5.9 6.5 1.5 11.95 1.5c5.45 0 9.9 4.4 9.9 9.8 0 5.4-4.45 9.8-9.9 9.8-2.2 0-4.35-.8-6.05-2.2L3 21z' 
  }
];

const quickLinks = [
  { name: 'Menú', href: '#menu' },
  { name: 'Paquetes', href: '#paquetes' },
  { name: 'Sucursales', href: '#sucursales' },
];

const branches = [
    { name: 'Miraflores', phone: '55 8445 7355', href: 'tel:5584457355' },
    { name: 'Chalco', phone: '55 7395 9109', href: 'tel:5573959109' }
];
---

<footer class="bg-[#0a0a0a] border-t border-white/5 pt-16 pb-8 relative overflow-hidden">
    
    {/* Decoración de fondo */}
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-3xl h-1 bg-gradient-to-r from-transparent via-brand-yellow/50 to-transparent opacity-50"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        
        {/* GRID PRINCIPAL */}
        <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-12">
            
            {/* 1. BRANDING & REDES */}
            <div class="space-y-6">
                <a href="#inicio" class="flex items-center gap-2 group w-fit">
                    <div class="bg-brand-yellow/10 p-2 rounded-full border border-brand-yellow/20 text-brand-yellow">
                         <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-5.5-2.5l7.51-3.22-3.22-7.51-7.51 3.22 3.22 7.51z"/>
                          </svg>
                    </div>
                    <span class="font-display text-2xl font-bold text-white tracking-wide">
                        PIZZE<span class="text-brand-yellow">TOS</span>
                    </span>
                </a>
                <p class="text-gray-400 text-sm leading-relaxed max-w-xs">
                    El verdadero sabor artesanal. Ingredientes frescos y masa perfecta en cada rebanada.
                </p>
                <div class="flex gap-4">
                    {socialLinks.map(social => (
                        <a 
                            href={social.href}
                            target="_blank"
                            class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center text-gray-400 hover:bg-brand-yellow hover:text-black transition-all duration-300 hover:-translate-y-1"
                            aria-label={social.name}
                        >
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                <path d={social.icon}></path>
                            </svg>
                        </a>
                    ))}
                </div>
            </div>

            {/* 2. ENLACES Y HORARIOS */}
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
                <div>
                    <h3 class="text-white font-bold text-lg mb-6 tracking-wide">Explorar</h3>
                    <ul class="space-y-3">
                        {quickLinks.map(link => (
                            <li>
                                <a href={link.href} class="text-gray-400 hover:text-brand-yellow transition-colors duration-300 text-sm">
                                    {link.name}
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>
                
                {/* HORARIOS ACTUALIZADOS */}
                <div>
                    <h3 class="text-white font-bold text-lg mb-6 tracking-wide">Horario</h3>
                    <ul class="space-y-3 text-sm text-gray-400">
                        <li class="flex flex-col">
                            <span class="font-medium text-brand-yellow">Lunes - Domingo</span>
                            <span>11:00 AM - 10:00 PM</span>
                        </li>
                    </ul>
                </div>
            </div>

            {/* 3. SUCURSALES */}
            <div>
                <h3 class="text-white font-bold text-lg mb-6 tracking-wide relative inline-block">
                    Nuestras Sucursales
                    <span class="absolute -bottom-2 left-0 w-8 h-1 bg-brand-yellow rounded-full"></span>
                </h3>
                <div class="space-y-6">
                    {branches.map(branch => (
                        <div class="group">
                            <h4 class="text-white font-bold text-base mb-1 group-hover:text-brand-yellow transition-colors">
                                Pizzetos {branch.name}
                            </h4>
                            <a href={branch.href} class="flex items-center gap-2 text-gray-400 hover:text-white transition-colors text-sm">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-brand-yellow" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                                </svg>
                                {branch.phone}
                            </a>
                        </div>
                    ))}
                </div>
            </div>

        </div>

        {/* BARRA INFERIOR */}
        <div class="border-t border-white/10 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-gray-500">
            <p>&copy; {currentYear} Pizzetos Pizza. Todos los derechos reservados.</p>
            <p>
                Desarrollado por 
                <a href="https://ollintem.com.mx" target="_blank" class="text-brand-yellow font-bold hover:underline ml-1">
                    Ollintem
                </a>
            </p>
        </div>
    </div>
</footer>