---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Common/Navbar.astro';
import Footer from '../components/Common/Footer.astro';
import ProductCard from '../components/Menu/ProductCard.astro';

// --- DATOS DE EJEMPLO (Basados en tu archivo original) ---
// En el futuro, esto lo moveremos a un archivo src/data/menu.js
const menuItems = [
  {
    id: 'hawaiana',
    name: 'Hawaiana',
    description: 'La clásica combinación de Jamón y Piña fresca.',
    price: 375, // Precio Familiar base
    imageSrc: 'https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80', // Placeholder de alta calidad
    category: 'Especialidades'
  },
  {
    id: 'pepperoni',
    name: 'Pepperoni',
    description: 'Doble porción de Pepperoni y abundante queso mozzarella.',
    price: 375,
    imageSrc: 'https://images.unsplash.com/photo-1628840042765-356cda07504e?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80',
    category: 'Especialidades'
  },
  {
    id: 'mexicana',
    name: 'Mexicana',
    description: 'Pierna, Pollo, Jalapeño y Aguacate selecto.',
    price: 375,
    imageSrc: 'https://images.unsplash.com/photo-1628840042765-356cda07504e?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80', // Placeholder
    category: 'Especialidades'
  },
  {
    id: 'camaron',
    name: 'Camarón',
    description: 'Deliciosos camarones salteados sobre base de queso.',
    price: 480,
    imageSrc: 'https://images.unsplash.com/photo-1513104890138-7c749659a591?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80',
    category: 'Mariscos',
    isPromo: false // Las de mariscos suelen ser precio diferente
  }
];
---

<Layout title="Pizzetos Pizza | Pide Online">
  <Navbar />

  <main>
    <section id="inicio" class="relative h-[80vh] min-h-[600px] flex items-center justify-center overflow-hidden">
      <div class="absolute inset-0 z-0">
        <img 
          src="https://images.unsplash.com/photo-1571997478779-2adcbbe9ab2f?ixlib=rb-1.2.1&auto=format&fit=crop&w=1920&q=80" 
          alt="Banner Pizzetos" 
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-brand-dark/70 via-brand-dark/50 to-brand-dark"></div>
      </div>

      <div class="relative z-10 text-center px-4 max-w-4xl mx-auto mt-20">
        <span class="text-brand-yellow font-bold tracking-[0.2em] uppercase text-sm md:text-base animate-fade-in-up">
          La mejor pizza de la ciudad
        </span>
        <h1 class="font-display text-5xl md:text-7xl lg:text-8xl text-white mt-4 mb-6 leading-tight drop-shadow-2xl">
          PIZZETOS <br /> <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-yellow to-yellow-500">PIZZA</span>
        </h1>
        <p class="text-gray-300 text-lg md:text-xl mb-10 max-w-2xl mx-auto font-light">
          Ingredientes frescos, masa artesanal y el sabor que ya conoces. 
          Pide ahora y recibe tu 2x1 en especialidades.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="#menu" class="bg-brand-yellow text-brand-dark px-8 py-4 rounded-full font-bold text-lg shadow-neon hover:scale-105 transition-transform duration-300">
            Ver Menú
          </a>
          <a href="#paquetes" class="bg-white/10 backdrop-blur-md border border-white/20 text-white px-8 py-4 rounded-full font-bold text-lg hover:bg-white/20 transition-colors duration-300">
            Ver Paquetes
          </a>
        </div>
      </div>
    </section>

    <section id="menu" class="py-20 bg-brand-dark relative">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center mb-16">
          <h2 class="font-display text-4xl md:text-5xl text-white mb-4">
            Nuestras <span class="text-brand-yellow border-b-4 border-brand-yellow pb-1">Especialidades</span>
          </h2>
          <p class="text-brand-gray mt-4 text-lg">
            Compra una pizza con 40% de descuento o arma tu par 2x1.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
          {menuItems.map((pizza) => (
            <div class="h-full">
<ProductCard
  id={pizza.id}
  name={pizza.name}
  description={pizza.description}
  price={pizza.price}
  imageSrc={pizza.imageSrc}
  category={pizza.category}  isPromo={pizza.category === 'Especialidades'}
/>
            </div>
          ))}
        </div>

        <div class="mt-16 text-center">
          <button class="text-white border-2 border-white/20 px-8 py-3 rounded-full hover:bg-white hover:text-brand-dark hover:border-white transition-all duration-300 font-bold tracking-wide">
            Ver Menú Completo
          </button>
        </div>

      </div>
    </section>

    <section id="paquetes" class="py-20 bg-brand-surface border-y border-white/5">
      <div class="max-w-7xl mx-auto px-4 text-center">
        <h3 class="font-display text-4xl text-white mb-12">Paquetes Populares</h3>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
            <div class="bg-brand-dark p-6 rounded-2xl border border-white/5 flex flex-col items-center hover:border-brand-yellow/50 transition-colors cursor-pointer group">
                <div class="w-full h-40 bg-gray-800 rounded-xl mb-4 overflow-hidden relative">
                    <div class="absolute inset-0 bg-brand-yellow/10 group-hover:bg-brand-yellow/20 transition-colors flex items-center justify-center">
                        <span class="font-display text-brand-yellow text-4xl">P1</span>
                    </div>
                </div>
                <h4 class="text-xl font-bold text-white">Paquete 1</h4>
                <p class="text-brand-gray text-sm my-2">2 Pizzas (Hawaiana/Pepperoni) + Refresco</p>
                <span class="text-brand-yellow font-display text-2xl mt-auto">$295</span>
            </div>

            <div class="bg-brand-dark p-6 rounded-2xl border border-white/5 flex flex-col items-center hover:border-brand-yellow/50 transition-colors cursor-pointer group">
                 <div class="w-full h-40 bg-gray-800 rounded-xl mb-4 overflow-hidden relative">
                    <div class="absolute inset-0 bg-brand-yellow/10 group-hover:bg-brand-yellow/20 transition-colors flex items-center justify-center">
                        <span class="font-display text-brand-yellow text-4xl">P3</span>
                    </div>
                </div>
                <h4 class="text-xl font-bold text-white">Paquete 3</h4>
                <p class="text-brand-gray text-sm my-2">3 Pizzas Grandes Especialidad + Refresco</p>
                <span class="text-brand-yellow font-display text-2xl mt-auto">$395</span>
            </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>