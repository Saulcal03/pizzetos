---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import MenuCard from '../components/Menu/MenuCard.astro';
import SizeSelector from '../components/Menu/SizeSelector.jsx';
import { menuItems } from '../data/menuData.js'; 
import ProductModal from '../components/Menu/ProductModal.jsx';

// --- NUEVA IMPORTACIÓN ---
import Sucursales from '../components/Sections/Sucursales.astro';

const allItems = menuItems || [];

// 1. SEPARAMOS LOS DATOS
const pizzas = allItems.filter(i => i.category === 'Pizzas' || i.category === 'Especialidades del Mar');
const paquetes = allItems.filter(i => i.category === 'Paquetes');
const snacks = allItems.filter(i => i.category === 'Snacks');
const bebidas = allItems.filter(i => i.category === 'Bebidas');

// Unimos todo lo "Extra" para la vista de complementos
const extras = [...paquetes, ...snacks, ...bebidas];
// Categorías para los botones de filtro de extras
const extraCategories = ["Todos", "Paquetes", "Snacks", "Bebidas"];
---

<Layout title="Pizzetos | Menú Premium">
  <main class="bg-neutral-950 min-h-screen pb-0 relative font-body pt-28 overflow-hidden">
    
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[500px] bg-amber-600/10 rounded-full blur-[120px] pointer-events-none z-0"></div>

    <section class="pb-4 text-center px-4 relative z-10">
      <h1 class="text-4xl md:text-5xl font-black text-white font-serif italic tracking-tighter cursor-pointer hover:text-amber-500 transition-colors" onclick="window.location.reload()">
        Pizzetos<span class="text-amber-500">.</span>
      </h1>
    </section>

    {/* --- PANTALLA 1: SELECTOR DE TAMAÑOS --- */}
    <div id="screen-sizes" class="transition-all duration-500 opacity-100 transform translate-x-0 pt-4 relative z-10">
      <SizeSelector client:load />
      
      <div class="text-center mt-8 animate-fade-in-up" style="animation-delay: 0.2s;">
        <p class="text-neutral-500 mb-6 text-sm uppercase tracking-widest font-bold">¿No quieres pizza?</p>
        <div class="flex flex-wrap justify-center gap-4">
            <button id="btn-show-extras" class="group relative px-8 py-3 rounded-full bg-white/5 border border-white/10 overflow-hidden hover:border-amber-500/50 transition-all">
                <span class="relative z-10 text-white font-bold text-sm group-hover:text-amber-500 transition-colors">Ver Paquetes y Snacks</span>
                <div class="absolute inset-0 bg-white/5 transform scale-x-0 group-hover:scale-x-100 transition-transform origin-left"></div>
            </button>
        </div>
      </div>
    </div>

    {/* --- PANTALLA 2: GRID DE SABORES (PIZZAS) --- */}
    <div id="screen-flavors" class="hidden opacity-0 transform translate-x-10 transition-all duration-500 max-w-7xl mx-auto px-4 pt-4 relative z-10">
      
      <div class="sticky top-4 z-40 bg-neutral-950/95 backdrop-blur-xl py-4 -mx-4 px-4 border-b border-white/10 mb-8 shadow-2xl rounded-b-2xl">
        
        <div class="flex items-center justify-between mb-4">
          <button id="btn-back-sizes" class="flex items-center gap-2 text-neutral-400 hover:text-white transition-colors group">
            <div class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center group-hover:bg-amber-500 group-hover:text-black transition-all">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
            </div>
            <span class="text-xs font-bold uppercase tracking-widest hidden sm:inline">Cambiar Tamaño</span>
          </button>
          
          <div class="text-right">
            <span class="text-[10px] text-neutral-500 uppercase tracking-widest block">Estás pidiendo</span>
            <span id="display-selected-size" class="text-xl font-serif text-amber-500 italic font-bold">--</span>
          </div>
        </div>

        <div class="flex flex-col md:flex-row gap-4 items-center justify-between">
            <div class="relative w-full md:w-1/3">
                <input 
                    type="text" 
                    id="pizza-search" 
                    placeholder="Buscar sabor (ej: Hawaiana)..." 
                    class="w-full bg-white/5 border border-white/10 rounded-full py-2 pl-10 pr-4 text-white text-sm focus:outline-none focus:border-amber-500 focus:bg-white/10 transition-all"
                />
                <svg class="absolute left-3 top-2.5 h-4 w-4 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
            </div>

            <div class="flex gap-2 overflow-x-auto pb-1 md:pb-0 w-full md:w-auto scrollbar-hide">
                <button class="cat-btn active" data-filter="all">Todas</button>
                <button class="cat-btn" data-filter="Pizzas">Clásicas</button>
                <button class="cat-btn" data-filter="Especialidades del Mar">Del Mar</button>
            </div>
        </div>
      </div>

      <div id="pizza-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 pb-20">
        {pizzas.map((item) => (
          <div class="pizza-item" data-name={item.name.toLowerCase()} data-category={item.category}>
            <MenuCard 
              id={item.id} name={item.name} description={item.description} 
              price={item.price} image={item.image} category={item.category}
              prices={item.prices} type={item.type}
            />
          </div>
        ))}
      </div>

      <div id="no-pizza-results" class="hidden text-center py-20">
        <p class="text-neutral-500 text-lg">No encontramos pizzas con ese nombre.</p>
        <button onclick="document.getElementById('pizza-search').value = ''; document.getElementById('pizza-search').dispatchEvent(new Event('input'));" class="text-amber-500 hover:underline mt-2">Borrar búsqueda</button>
      </div>

    </div>

    {/* --- PANTALLA 3: EXTRAS (PAQUETES, SNACKS) --- */}
    <div id="screen-extras" class="hidden opacity-0 transform translate-y-10 transition-all duration-500 max-w-7xl mx-auto px-4 pt-4 relative z-10">
        
        <div class="flex items-center mb-8">
            <button id="btn-back-home" class="flex items-center gap-2 text-neutral-400 hover:text-white transition-colors group">
                <div class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center group-hover:bg-amber-500 group-hover:text-black transition-all">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
                </div>
                <span class="text-sm font-bold uppercase tracking-widest">Volver al Inicio</span>
            </button>
        </div>

        <h2 class="text-3xl font-serif text-white italic mb-8 text-center">Complementos</h2>

        <div class="flex justify-center gap-2 mb-10">
            {extraCategories.map(cat => (
                <button class="extra-cat-btn px-4 py-2 rounded-full border border-white/10 text-xs font-bold uppercase text-neutral-400 hover:text-white hover:border-amber-500 transition-all" data-filter={cat}>
                    {cat}
                </button>
            ))}
        </div>

        <div id="extras-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 pb-20">
            {extras.map((item) => (
                <div class="extra-item" data-category={item.category}>
                    <MenuCard 
                        id={item.id} name={item.name} description={item.description} 
                        price={item.price} image={item.image} category={item.category}
                        prices={item.prices} type={item.type}
                    />
                </div>
            ))}
        </div>
    </div>

    {/* --- SECCIÓN SUCURSALES (SIEMPRE VISIBLE AL FINAL) --- */}
    {/* Le ponemos el ID para que el link del Navbar funcione */}
    <div id="sucursales" class="relative z-20 mt-20">
       <Sucursales />
    </div>

  </main>
  <ProductModal client:load />
</Layout>

<style>
    .cat-btn {
        padding: 8px 16px;
        border-radius: 999px;
        font-size: 0.8rem;
        font-weight: bold;
        text-transform: uppercase;
        color: #737373;
        border: 1px solid rgba(255,255,255,0.1);
        transition: all 0.3s ease;
        white-space: nowrap;
    }
    .cat-btn:hover { color: white; border-color: rgba(255,255,255,0.3); }
    .cat-btn.active {
        background-color: #f59e0b;
        color: #171717;
        border-color: #f59e0b;
        box-shadow: 0 0 15px rgba(245, 158, 11, 0.2);
    }
    .scrollbar-hide::-webkit-scrollbar { display: none; }
    .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
</style>

<script>
  import { selectedGlobalSize } from '../stores/cartStore.js';

  function initAppLogic() {
    // Referencias a las pantallas
    const screenSizes = document.getElementById('screen-sizes');
    const screenFlavors = document.getElementById('screen-flavors');
    const screenExtras = document.getElementById('screen-extras');
    
    // Referencias a botones internos
    const displaySize = document.getElementById('display-selected-size');
    const btnBackSizes = document.getElementById('btn-back-sizes');
    const btnShowExtras = document.getElementById('btn-show-extras');
    const btnBackHome = document.getElementById('btn-back-home');

    // --- 1. FUNCIÓN PARA CAMBIAR PANTALLAS ---
    const showScreen = (screenId) => {
        // Ocultar todas primero
        [screenSizes, screenFlavors, screenExtras].forEach(s => {
            if (s) {
                s.classList.add('hidden', 'opacity-0', 'pointer-events-none');
                s.classList.remove('translate-x-0', 'translate-y-0');
            }
        });

        // Mostrar la deseada
        const target = document.getElementById(screenId);
        if (target) {
            target.classList.remove('hidden');
            // Pequeño delay para la animación suave
            setTimeout(() => {
                target.classList.remove('opacity-0', 'pointer-events-none');
                target.classList.add('translate-x-0', 'translate-y-0');
                // Scroll arriba para que se vea bien
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }, 50);
        }
    };

    // --- 2. CEREBRO DE NAVEGACIÓN ---
    const handleNavigation = () => {
        const hash = window.location.hash; // Detecta #paquetes, #snacks, etc.

        if (hash === '#paquetes') {
            selectedGlobalSize.set(null);
            showScreen('screen-extras');
            setTimeout(() => {
                const btn = document.querySelector('.extra-cat-btn[data-filter="Paquetes"]');
                if(btn) btn.click();
            }, 100);

        } else if (hash === '#snacks') {
            selectedGlobalSize.set(null);
            showScreen('screen-extras');
            setTimeout(() => {
                const btn = document.querySelector('.extra-cat-btn[data-filter="Snacks"]');
                if(btn) btn.click();
            }, 100);

        } else if (hash === '#pizzas-especialidad') {
            selectedGlobalSize.set(null);
            showScreen('screen-sizes');
        } 
        // NOTA: No controlamos '#sucursales' aquí para dejar que el navegador haga scroll nativo
    };

    // Escuchar cambios en la URL (cuando haces clic en el menú)
    window.addEventListener('hashchange', handleNavigation);
    
    // Verificar si ya viene con un link al cargar la página
    handleNavigation();


    // --- 3. LÓGICA ORIGINAL DE TU APP (STORE) ---
    selectedGlobalSize.subscribe(size => {
        const hash = window.location.hash;
        if(hash === '#paquetes' || hash === '#snacks') return; 

        if (size) {
            if(displaySize) displaySize.textContent = size;
            showScreen('screen-flavors');
        } else {
            if(screenExtras && !screenExtras.classList.contains('hidden')) return;
            showScreen('screen-sizes');
        }
    });

    btnBackSizes?.addEventListener('click', () => selectedGlobalSize.set(null));
    
    btnShowExtras?.addEventListener('click', () => {
        selectedGlobalSize.set(null);
        history.pushState("", document.title, window.location.pathname + window.location.search);
        showScreen('screen-extras');
    });

    btnBackHome?.addEventListener('click', () => {
        history.pushState("", document.title, window.location.pathname + window.location.search);
        showScreen('screen-sizes');
    });


    // --- 4. BÚSQUEDA Y FILTROS DE PIZZAS ---
    const searchInput = document.getElementById('pizza-search');
    const catButtons = document.querySelectorAll('.cat-btn');
    const pizzaItems = document.querySelectorAll('.pizza-item');
    const noResults = document.getElementById('no-pizza-results');
    let currentFilter = 'all';

    const filterPizzas = () => {
        if (!(searchInput instanceof HTMLInputElement)) return;
        const term = searchInput.value.toLowerCase();
        let count = 0;

        pizzaItems.forEach(item => {
            const name = item.getAttribute('data-name');
            const category = item.getAttribute('data-category');
            const matchesSearch = name && name.includes(term);
            const matchesCat = currentFilter === 'all' || category === currentFilter;

            if (matchesSearch && matchesCat) {
                item.classList.remove('hidden');
                count++;
            } else {
                item.classList.add('hidden');
            }
        });
        if(noResults) noResults.style.display = count === 0 ? 'block' : 'none';
    };

    if (searchInput) searchInput.addEventListener('input', filterPizzas);

    catButtons.forEach(btn => {
        btn.addEventListener('click', () => {
            catButtons.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            currentFilter = btn.getAttribute('data-filter') || 'all';
            filterPizzas();
        });
    });

    // --- 5. FILTROS EXTRAS ---
    const extraButtons = document.querySelectorAll('.extra-cat-btn');
    const extraItems = document.querySelectorAll('.extra-item');

    extraButtons.forEach(btn => {
        btn.addEventListener('click', () => {
            extraButtons.forEach(b => {
                b.classList.remove('bg-amber-500', 'text-black', 'border-amber-500');
                b.classList.add('text-neutral-400', 'border-white/10');
            });
            btn.classList.remove('text-neutral-400', 'border-white/10');
            btn.classList.add('bg-amber-500', 'text-black', 'border-amber-500');

            const filter = btn.getAttribute('data-filter');
            extraItems.forEach(item => {
                if(filter === 'Todos' || item.getAttribute('data-category') === filter) {
                    item.classList.remove('hidden');
                } else {
                    item.classList.add('hidden');
                }
            });
        });
    });

    if(!window.location.hash && extraButtons.length > 0) {
        const firstBtn = extraButtons[0];
        if(firstBtn instanceof HTMLElement) firstBtn.click();
    }
  }

  document.addEventListener('astro:page-load', initAppLogic);
  document.addEventListener('DOMContentLoaded', initAppLogic);
</script>