---
import '../styles/global.css';
// 1. Importamos el componente del carrito (IMPORTANTE)
import CartFlyout from '../components/Cart/CartFlyout.jsx';

interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content="Pizzetos Pizza - La mejor pizza a domicilio" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Anton&family=Quicksand:wght@400;600;700&display=swap" rel="stylesheet">
        <title>{title}</title>
    </head>
    <body class="bg-brand-dark text-white font-sans antialiased selection:bg-brand-yellow selection:text-brand-dark">
        <slot />
        
        <CartFlyout client:idle />
    </body>
</html>